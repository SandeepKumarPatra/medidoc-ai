# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medidoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medidoc
POSTGRES_PORT=5432

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
# Optional OpenAI fallback
OPENAI_API_KEY=your-openai-api-key-here

# Embeddings Configuration
# Dev default: BAAI/bge-small-en-v1.5 (384 dim); production option: BAAI/bge-m3 (1024 dim)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Reranker Configuration
# Dev default: BAAI/bge-reranker-base; production option: BAAI/bge-reranker-v2-m3
RERANKER_MODEL=BAAI/bge-reranker-base

# App Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
