# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medidoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=medidoc
POSTGRES_PORT=5432

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT=30
LLM_THINKING_BUDGET=0
# Optional OpenAI fallback
OPENAI_API_KEY=your-openai-api-key-here

# Embeddings Configuration
# Dev default: BAAI/bge-small-en-v1.5 (384 dim); production option: BAAI/bge-m3 (1024 dim)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Chunking Configuration
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=100
CHILD_CHUNK_TOKENS=100
CHILD_CHUNK_OVERLAP=20

# Reranker Configuration
# Choices: BAAI/bge-reranker-base (default), cross-encoder/ms-marco-MiniLM-L-6-v2 (fast CPU), BAAI/bge-reranker-v2-m3
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=10

# App Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
